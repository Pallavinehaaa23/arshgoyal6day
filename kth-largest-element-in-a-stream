class KthLargest {
private:
    priority_queue<int, vector<int>, greater<int>> pq; // Min-heap
    int k;

public:
    KthLargest(int k, vector<int>& nums) {
        this->k = k;
        for (int num : nums) {
            add(num); // Add elements to the priority queue using the `add` method
        }
    }
    
    int add(int val) {
        pq.push(val);
        if (pq.size() > k) {
            pq.pop(); // Remove the smallest element to maintain size k
        }
        return pq.top(); // The top of the min-heap is the k-th largest element
    }
};

