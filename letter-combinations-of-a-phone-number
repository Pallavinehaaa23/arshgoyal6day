class Solution {
public:
vector<string>ans;
void f(string digits,unordered_map<int,vector<char>>&mp,string tmp,int ind){
if(tmp.size()==digits.size()){
    if(tmp!="")
    ans.push_back(tmp);
    return;
}
for(int i=ind;i<digits.size();i++){
    for(auto j:mp[digits[i]-'0']){
        f(digits,mp,tmp+j,i+1);
    }
}
}
    vector<string> letterCombinations(string digits) {
unordered_map<int,vector<char>>mp={
 {2, {'a', 'b', 'c'}},
        {3, {'d', 'e', 'f'}},
        {4, {'g', 'h', 'i'}},
        {5, {'j', 'k', 'l'}},
        {6, {'m', 'n', 'o'}},
        {7, {'p', 'q', 'r', 's'}},
        {8, {'t', 'u', 'v'}},
        {9, {'w', 'x', 'y', 'z'}}
};
string temp="";
f(digits,mp,temp,0);
// if(ans.size()==0)return {};
return ans;
    }
};
