class Solution {
public:
    vector<vector<int>> ans;
    set<vector<int>> st;

    void f(int k, int n, vector<int>& temp, unordered_map<int, int>& mp) {
        if (temp.size() == k && n == 0) {
            sort(temp.begin(), temp.end());
            if (st.find(temp) == st.end()) { // Check if the combination is unique
                st.insert(temp);
                ans.push_back(temp);
            }
            return;
        }

        if (temp.size() == k || n == 0) return;

        for (int i = 1; i <= 9; i++) {
            if (mp[i] == 0 && n >= i) {
                temp.push_back(i);
                mp[i] = 1; 
                f(k, n - i, temp, mp);
                temp.pop_back(); 
                mp[i] = 0; // Unmark the number
            }
        }
    }

    vector<vector<int>> combinationSum3(int k, int n) {
        vector<int> temp;
        unordered_map<int, int> mp;
        for (int i = 1; i <= 9; i++) {
            mp[i] = 0;
        }
        f(k, n, temp, mp);
        return ans;
    }
};
