class Solution {
public:
    vector<string> findHighAccessEmployees(vector<vector<string>>& access_times) {
        sort(access_times.begin(), access_times.end());
        vector<string> ans;
        map<string, vector<string>> mp;

        for (int i = 0; i < access_times.size(); i++) {
            mp[access_times[i][0]].push_back(access_times[i][1]);
        }

        for (auto i : mp) {
            int cnt = 0;
            for (int j = 0; j < i.second.size(); j++) {
                cnt = 1; // Current time is always included
                for (int k = j + 1; k < i.second.size(); k++) {
                    if (stoi(i.second[k]) - stoi(i.second[j]) < 100) {
                        cnt++;
                    } else {
                        break; // Exit early if time difference exceeds 100
                    }
                }
                if (cnt >= 3) {
                    ans.push_back(i.first);
                    break; // No need to check further for this employee
                }
            }
        }

        return ans;
    }
};
